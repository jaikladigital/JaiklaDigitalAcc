# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Configuration for Vercel / GitHub CI/CD Deployment
# Note: In AI Studio, firebase-applet-config.json is used automatically.
# When deploying to Vercel, set these VITE_FIREBASE_* environment variables:
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_DATABASE_ID="(default)"

# LINE Official Account (@421khbew) Messaging API (Server-side only)
# Optional: When configured in Secrets/Env, emergency cash alerts push/broadcast automatically.
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_TARGET_ID=""


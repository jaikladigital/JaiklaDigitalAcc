{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated staff or administrator profile with role assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin lookup record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "CompanyProfile": {
      "title": "CompanyProfile",
      "description": "Company profile, bank details, default tax rates, and branding assets for Jaikla Digital Co., Ltd.",
      "type": "object",
      "properties": {
        "companyNameTh": { "type": "string", "minLength": 1, "maxLength": 200 },
        "companyNameEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "taxId": { "type": "string", "minLength": 10, "maxLength": 30 },
        "branch": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "minLength": 1, "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "bankName": { "type": "string", "maxLength": 150 },
        "bankBranch": { "type": "string", "maxLength": 150 },
        "bankAccountNo": { "type": "string", "maxLength": 50 },
        "bankAccountName": { "type": "string", "maxLength": 200 },
        "defaultVatRate": { "type": "number" },
        "defaultWhtRate": { "type": "number" },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "watermarkUrl": { "type": "string", "maxLength": 1000 },
        "stampUrl": { "type": "string", "maxLength": 1000 },
        "signatureUrl": { "type": "string", "maxLength": 1000 },
        "lineOaId": { "type": "string", "maxLength": 60 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyNameTh", "companyNameEn", "taxId", "address", "bankAccountNo", "defaultVatRate", "defaultWhtRate", "updatedBy", "updatedAt"]
    },
    "ServiceCategory": {
      "title": "ServiceCategory",
      "description": "Dynamic supplier service category managed by staff and admins.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "defaultWhtRate": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "teamUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "defaultWhtRate", "createdBy", "teamUids", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client organization and contact details for quotations, invoices, and tax analytics.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "taxId": { "type": "string", "maxLength": 30 },
        "branch": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "minLength": 1, "maxLength": 600 },
        "contactName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 60 },
        "email": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "teamUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "address", "createdBy", "teamUids", "createdAt", "updatedAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Vendor/supplier record with service category, pricing rate, and WHT 50 Tawi details.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 250 },
        "taxId": { "type": "string", "maxLength": 30 },
        "entityType": { "type": "string", "enum": ["corporate", "individual"] },
        "address": { "type": "string", "maxLength": 600 },
        "contactName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 60 },
        "email": { "type": "string", "maxLength": 150 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryName": { "type": "string", "maxLength": 150 },
        "baseRate": { "type": "number" },
        "unit": { "type": "string", "maxLength": 60 },
        "rating": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "teamUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "entityType", "categoryId", "baseRate", "createdBy", "teamUids", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Event or campaign project linked to a customer with duration and budget tracking.",
      "type": "object",
      "properties": {
        "eventName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "durationStart": { "type": "string", "maxLength": 30 },
        "durationEnd": { "type": "string", "maxLength": 30 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "maxLength": 250 },
        "status": { "type": "string", "enum": ["active", "completed", "cancelled"] },
        "budgetLimit": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "teamUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventName", "customerId", "status", "createdBy", "teamUids", "createdAt", "updatedAt"]
    },
    "AccountingDocument": {
      "title": "AccountingDocument",
      "description": "Quotation (QUO), Invoice/Billing/Delivery (INV), or Receipt (REC) with tax, installment, and watermark settings.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["QT", "INV", "REC"] },
        "docNumber": { "type": "string", "minLength": 1, "maxLength": 60 },
        "docDate": { "type": "string", "maxLength": 30 },
        "dueDate": { "type": "string", "maxLength": 30 },
        "copyType": { "type": "string", "enum": ["original", "copy"] },
        "refDocId": { "type": "string", "maxLength": 128 },
        "refDocNumber": { "type": "string", "maxLength": 60 },
        "installmentInfo": { "type": "object" },
        "projectId": { "type": "string", "maxLength": 128 },
        "eventName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "durationText": { "type": "string", "maxLength": 120 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerEntityType": { "type": "string", "enum": ["corporate", "individual"] },
        "customerSnapshot": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "vatEnabled": { "type": "boolean" },
        "vatRate": { "type": "number" },
        "vatAmount": { "type": "number" },
        "whtEnabled": { "type": "boolean" },
        "whtRate": { "type": "number" },
        "whtAmount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "netPayable": { "type": "number" },
        "thaiBahtText": { "type": "string", "maxLength": 400 },
        "notesRed": { "type": "string", "maxLength": 1500 },
        "termsText": { "type": "string", "maxLength": 2000 },
        "paymentMethod": { "type": "string", "enum": ["transfer", "cheque", "cash", "other"] },
        "paymentBank": { "type": "string", "maxLength": 150 },
        "paymentChequeNo": { "type": "string", "maxLength": 100 },
        "paymentDate": { "type": "string", "maxLength": 30 },
        "watermarkConfig": { "type": "object" },
        "showStamp": { "type": "boolean" },
        "showSignature": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "issued", "approved", "paid", "cancelled"] },
        "issueMode": { "type": "string", "enum": ["normal", "backdated", "advance", "special"] },
        "specialDeliveryDate": { "type": "string", "maxLength": 30 },
        "revisionNumber": { "type": "number" },
        "specialCaseReason": { "type": "string", "maxLength": 500 },
        "showSpecialNoteOnPdf": { "type": "boolean" },
        "lastEditedBy": { "type": "string", "maxLength": 150 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "teamUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "docNumber", "docDate", "copyType", "eventName", "customerId", "customerSnapshot", "items", "subtotal", "vatEnabled", "vatRate", "vatAmount", "whtEnabled", "whtRate", "whtAmount", "grandTotal", "netPayable", "status", "createdBy", "teamUids", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Project expense entry with supplier linkage, VAT/WHT 50 Tawi tracking, and receipt image URL.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "supplierTaxId": { "type": "string", "maxLength": 30 },
        "supplierAddress": { "type": "string", "maxLength": 600 },
        "payeeEntityType": { "type": "string", "enum": ["corporate", "individual"] },
        "whtFormType": { "type": "string", "enum": ["PND3", "PND53", "PND1", "NONE"] },
        "whtIncomeCode": { "type": "string", "maxLength": 60 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "amount": { "type": "number" },
        "vatRate": { "type": "number" },
        "vatAmount": { "type": "number" },
        "whtRate": { "type": "number" },
        "whtAmount": { "type": "number" },
        "netPaid": { "type": "number" },
        "paymentDate": { "type": "string", "minLength": 8, "maxLength": 30 },
        "monthYear": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "receiptUrl": { "type": "string", "maxLength": 60000 },
        "extraPhotoUrl": { "type": "string", "maxLength": 60000 },
        "scanFileUrl": { "type": "string", "maxLength": 2000 },
        "scanFileName": { "type": "string", "maxLength": 250 },
        "scanFileType": { "type": "string", "maxLength": 100 },
        "scanPageCount": { "type": "number" },
        "scanFileSizeBytes": { "type": "number" },
        "wht50TawiNo": { "type": "string", "maxLength": 60 },
        "wht50TawiIssued": { "type": "boolean" },
        "incomeType50Tawi": { "type": "string", "maxLength": 200 },
        "isEmergencyCash": { "type": "boolean" },
        "emergencyVoucherNo": { "type": "string", "maxLength": 60 },
        "payerType": { "type": "string", "enum": ["employee", "supplier"] },
        "payerName": { "type": "string", "maxLength": 250 },
        "payerPhone": { "type": "string", "maxLength": 60 },
        "urgencyReason": { "type": "string", "maxLength": 500 },
        "emergencyStatus": { "type": "string", "enum": ["pending_reimburse", "approved", "reimbursed"] },
        "lineNotifiedAt": { "type": "string", "maxLength": 50 },
        "lineNotifyChannel": { "type": "string", "maxLength": 50 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "teamUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "eventName", "supplierName", "description", "amount", "vatRate", "vatAmount", "whtRate", "whtAmount", "netPaid", "paymentDate", "monthYear", "createdBy", "teamUids", "createdAt", "updatedAt"]
    },
    "AnnualFinancialLedger": {
      "title": "AnnualFinancialLedger",
      "description": "Annual balance sheet, income statement, equity statement, notes, and DBD/Revenue Department filing ledger.",
      "type": "object",
      "properties": {
        "fiscalYearBe": { "type": "number" },
        "fiscalYearCe": { "type": "number" },
        "dataSourceMode": { "type": "string", "enum": ["audited", "live_sync"] },
        "cashOnHand": { "type": "number" },
        "cashAtBank": { "type": "number" },
        "tradeReceivables": { "type": "number" },
        "accruedInterestReceivable": { "type": "number" },
        "withholdingTaxAsset": { "type": "number" },
        "revenueDeptReceivable": { "type": "number" },
        "prepaidExpenses": { "type": "number" },
        "workInProgress": { "type": "number" },
        "otherCurrentAssets": { "type": "number" },
        "relatedPartyLoan": { "type": "number" },
        "equipmentToolsCost": { "type": "number" },
        "equipmentToolsAccumDep": { "type": "number" },
        "equipmentToolsDepYear": { "type": "number" },
        "equipmentOfficeCost": { "type": "number" },
        "equipmentOfficeAccumDep": { "type": "number" },
        "equipmentOfficeDepYear": { "type": "number" },
        "tradePayables": { "type": "number" },
        "unearnedRevenue": { "type": "number" },
        "customerDeposits": { "type": "number" },
        "accruedExpenses": { "type": "number" },
        "withholdingTaxPayable": { "type": "number" },
        "otherCurrentLiabilities": { "type": "number" },
        "registeredCapitalShares": { "type": "number" },
        "parValuePerShare": { "type": "number" },
        "paidUpCapital": { "type": "number" },
        "retainedEarningsOpening": { "type": "number" },
        "serviceRevenue": { "type": "number" },
        "otherIncome": { "type": "number" },
        "costOfServices": { "type": "number" },
        "sellingExpenses": { "type": "number" },
        "adminExpenses": { "type": "number" },
        "incomeTaxExpense": { "type": "number" },
        "registrationNumber": { "type": "string", "maxLength": 40 },
        "registrationDateTh": { "type": "string", "maxLength": 80 },
        "businessAddress": { "type": "string", "maxLength": 500 },
        "directorName": { "type": "string", "maxLength": 150 },
        "cpaFirmName": { "type": "string", "maxLength": 200 },
        "cpaAuditorName": { "type": "string", "maxLength": 150 },
        "cpaLicenseNo": { "type": "string", "maxLength": 60 },
        "auditDateTh": { "type": "string", "maxLength": 80 },
        "agmMeetingNo": { "type": "string", "maxLength": 40 },
        "agmDateTh": { "type": "string", "maxLength": 80 },
        "dbdSubmitted": { "type": "boolean" },
        "rdPnd50Submitted": { "type": "boolean" },
        "rdPnd51Submitted": { "type": "boolean" },
        "taxLossCarryforward5Yr": { "type": "number" },
        "taxNonDeductibleAddBack": { "type": "number" },
        "notesSummary": { "type": "string", "maxLength": 1500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "teamUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fiscalYearBe", "fiscalYearCe", "dataSourceMode", "cashOnHand", "cashAtBank", "paidUpCapital", "serviceRevenue", "costOfServices", "adminExpenses", "registrationNumber", "directorName", "createdBy", "teamUids", "createdAt", "updatedAt"]
    },
    "UrgentExpenseRequest": {
      "title": "UrgentExpenseRequest",
      "description": "Public no-login urgent cash disbursement submission with callback contact details (LINE ID, email, phone) for admin review and LINE OA alert.",
      "type": "object",
      "properties": {
        "voucherNo": { "type": "string", "minLength": 3, "maxLength": 60 },
        "payerType": { "type": "string", "enum": ["employee", "supplier"] },
        "payerName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "submitterLineId": { "type": "string", "maxLength": 100 },
        "submitterEmail": { "type": "string", "maxLength": 150 },
        "submitterPhone": { "type": "string", "maxLength": 60 },
        "projectName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "vendorName": { "type": "string", "maxLength": 250 },
        "vendorTaxId": { "type": "string", "maxLength": 30 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "urgencyReason": { "type": "string", "maxLength": 500 },
        "amount": { "type": "number" },
        "vatRate": { "type": "number" },
        "vatAmount": { "type": "number" },
        "whtRate": { "type": "number" },
        "whtAmount": { "type": "number" },
        "netPaid": { "type": "number" },
        "paymentDate": { "type": "string", "minLength": 8, "maxLength": 30 },
        "receiptUrl": { "type": "string", "maxLength": 60000 },
        "extraPhotoUrl": { "type": "string", "maxLength": 60000 },
        "status": { "type": "string", "enum": ["pending_review", "approved", "imported", "rejected"] },
        "importedExpenseId": { "type": "string", "maxLength": 128 },
        "lineNotifiedAt": { "type": "string", "maxLength": 50 },
        "lineNotifyChannel": { "type": "string", "maxLength": 50 },
        "reviewNotes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["voucherNo", "payerType", "payerName", "submitterLineId", "submitterEmail", "submitterPhone", "projectName", "description", "amount", "vatRate", "vatAmount", "whtRate", "whtAmount", "netPaid", "paymentDate", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and RBAC roles."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin directory for fast exists() role checks."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Company profile, bank info, default tax rates, and brand assets."
    },
    "/service_categories/{categoryId}": {
      "schema": { "$ref": "#/entities/ServiceCategory" },
      "description": "Dynamic supplier service categories."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer master database."
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Supplier database for price comparison and 50 Tawi."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Project / Event records linked to customers."
    },
    "/documents/{docId}": {
      "schema": { "$ref": "#/entities/AccountingDocument" },
      "description": "Quotations, Invoices/Billing/Delivery notes, and Receipts."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Project expenses with receipt uploads and 50 Tawi records."
    },
    "/annual_ledgers/{ledgerId}": {
      "schema": { "$ref": "#/entities/AnnualFinancialLedger" },
      "description": "Annual balance sheet, income statement, equity statement, and DBD/RD filing records."
    },
    "/urgent_requests/{requestId}": {
      "schema": { "$ref": "#/entities/UrgentExpenseRequest" },
      "description": "Public no-login urgent cash disbursement submissions awaiting admin verification."
    }
  }
}
